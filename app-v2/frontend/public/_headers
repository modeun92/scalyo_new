# Scalyo — Cloudflare Pages headers
# De-indexing of surfaces with no search value.
# "follow" is kept so Googlebot keeps reading the internal linking.

/login
  X-Robots-Tag: noindex, follow
/register
  X-Robots-Tag: noindex, follow
/join
  X-Robots-Tag: noindex, follow
/join/*
  X-Robots-Tag: noindex, follow
/paywall
  X-Robots-Tag: noindex, follow
/payment-success
  X-Robots-Tag: noindex, follow
/reset-password
  X-Robots-Tag: noindex, follow
/reset-password-confirm
  X-Robots-Tag: noindex, follow
/app/*
  X-Robots-Tag: noindex, follow

# Brand assets: long cache, they do not change.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-96.png
  Cache-Control: public, max-age=604800
/favicon-192.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/scalyo-logo.png
  Cache-Control: public, max-age=604800
/og-default.png
  Cache-Control: public, max-age=604800
